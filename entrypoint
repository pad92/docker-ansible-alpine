#!/bin/sh
# Keep optional SSH setup best-effort; installation steps below fail explicitly.
set -u
#
# Simple wrapper for executing ansible-galaxy and ansible-playbook.
#
# USAGE:
#    ansible-playbook-wrapper  [other ansible-playbook arguments]
#
# ENVIRONMENT VARIABLES:
#
#    - PIP_REQUIREMENTS:        pip requirements filename;
#                               default = "requirements.txt"
#    - ANSIBLE_REQUIREMENTS:    ansible requirements filename;
#                               default = "requirements.yml"
#    - DEPLOY_KEY               deploy key (private)

# Rotate ansible log if exist
if [ -f "ansible.log" ]; then
    DATE_LOG=$(date -d "$(head -1 ansible.log  | cut -d, -f1 )" +%Y%m%d-%H%M%S) 2>/dev/null
    if [ -n "$DATE_LOG" ]; then
        mv ansible.log ansible-${DATE_LOG}.log
        gzip ansible-${DATE_LOG}.log &
    fi
fi

# Optional deploy key
if [ -n "${DEPLOY_KEY:-}" ] && [ ! -f "/root/.ssh/id_rsa" ]; then
    mkdir -p /root/.ssh/
    echo "${DEPLOY_KEY}" > /root/.ssh/id_rsa
    chmod 0600 /root/.ssh/id_rsa
fi

# Loadkey into ssh-agent if key exist
if [ -f "/root/.ssh/id_rsa" ]; then
    eval $(ssh-agent)
    ssh-add /root/.ssh/id_rsa
fi

# upgrade ca-certificates package
if [ "x${CA_CERT_UPGRADE:-}" = "xtrue" ]; then
    apk add --upgrade --no-cache ca-certificates
fi

# Export the CA bundle before any Python network operation.
if [ -z "${REQUESTS_CA_BUNDLE:-}" ]; then
    REQUESTS_CA_BUNDLE='/etc/ssl/certs/ca-certificates.crt'
fi
export REQUESTS_CA_BUNDLE

# Load custom certificates before installing pip or Galaxy requirements.
if [ "$(find /usr/local/share/ca-certificates/ -type f -name '*.crt' 2>/dev/null | wc -l)" -gt "0" ]; then
    update-ca-certificates
fi

# install pip requirements, if any
if [ -z "${PIP_REQUIREMENTS:-}" ]; then
    PIP_REQUIREMENTS=requirements.txt
fi

if [ -f "$PIP_REQUIREMENTS" ]; then
    if ! pip3 install --no-compile --upgrade -r "$PIP_REQUIREMENTS"; then
        echo "pip requirements installation failed" >&2
        exit 1
    fi
fi

# install Galaxy roles, if any
if [ -z "${ANSIBLE_REQUIREMENTS:-}" ]; then
    ANSIBLE_REQUIREMENTS=requirements.yml
fi

if [ -f "$ANSIBLE_REQUIREMENTS" ]; then
    if ! ansible-galaxy install ${ANSIBLE_GALAXY_PARAM:-} -r "$ANSIBLE_REQUIREMENTS"; then
        echo "Ansible Galaxy requirements installation failed" >&2
        exit 1
    fi
fi

exec "$@"
